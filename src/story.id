
import React, { useState } from "react";
import {
  Search,
  Menu,
  X,
  UserRound,
  Bookmark,
  ChevronRight,
  Sparkles,
  Compass,
  Clock3,
  Heart,
  BookOpen,
  Bell
} from "lucide-react";

const stories = [
  {
    id: 1,
    title: "The Moonlit Garden",
    genre: "Fantasy · Romance",
    chapter: "Chapter 24",
    color: "cover-one",
    label: "NEW"
  },
  {
    id: 2,
    title: "A Winter Promise",
    genre: "Drama · Romance",
    chapter: "Chapter 18",
    color: "cover-two",
    label: "HOT"
  },
  {
    id: 3,
    title: "Beyond the Stars",
    genre: "Adventure · Fantasy",
    chapter: "Chapter 32",
    color: "cover-three",
    label: "NEW"
  },
  {
    id: 4,
    title: "The Secret Duchess",
    genre: "Historical · Drama",
    chapter: "Chapter 15",
    color: "cover-four",
    label: ""
  },
  {
    id: 5,
    title: "Silver Memories",
    genre: "Fantasy · Mystery",
    chapter: "Chapter 09",
    color: "cover-five",
    label: ""
  },
  {
    id: 6,
    title: "When Flowers Bloom",
    genre: "Romance · Slice of Life",
    chapter: "Chapter 41",
    color: "cover-six",
    label: "HOT"
  }
];

const categories = [
  "All",
  "Romance",
  "Fantasy",
  "Action",
  "Drama",
  "Mystery",
  "Adventure"
];

function Cover({ story }) {
  return (
    <div className={`story-cover ${story.color}`}>
      <span className="cover-decoration">✦</span>
      <span className="cover-small">MEROVA COLLECTION</span>
      <strong>{story.title}</strong>
      <span className="cover-decoration bottom-star">✧</span>
    </div>
  );
}

function StoryCard({ story }) {
  return (
    <article className="story-card">
      <div className="cover-wrap">
        <Cover story={story} />
        {story.label && (
          <span className="story-label">{story.label}</span>
        )}
        <button
          className="save-button"
          aria-label="Save story"
          onClick={() => alert("Favorites will be available soon.")}
        >
          <Bookmark size={17} />
        </button>
      </div>
      <h3>{story.title}</h3>
      <p>{story.genre}</p>
      <span className="chapter-text">{story.chapter}</span>
    </article>
  );
}

function StorySection({ title, subtitle, icon, items }) {
  return (
    <section className="content-section">
      <div className="section-heading">
        <div>
          <div className="section-title">
            {icon}
            <h2>{title}</h2>
          </div>
          <p>{subtitle}</p>
        </div>
        <button className="see-all">
          See all <ChevronRight size={16} />
        </button>
      </div>

      <div className="story-grid">
        {items.map((story) => (
          <StoryCard key={story.id} story={story} />
        ))}
      </div>
    </section>
  );
}

export default function App() {
  const [category, setCategory] = useState("All");
  const [search, setSearch] = useState("");
  const [menuOpen, setMenuOpen] = useState(false);

  const filteredStories = stories.filter((story) => {
    const matchesCategory =
      category === "All" ||
      story.genre.toLowerCase().includes(category.toLowerCase());

    const matchesSearch =
      story.title.toLowerCase().includes(search.toLowerCase());

    return matchesCategory && matchesSearch;
  });

  return (
    <div className="app">
      <header className="topbar">
        <a className="brand" href="#">
          <span className="brand-mark">M</span>
          <span>MEROVA</span>
        </a>

        <nav className="desktop-nav">
          <a className="active" href="#explore">Explore</a>
          <a href="#featured">Featured</a>
          <a href="#latest">Latest</a>
          <a href="#recommended">For You</a>
        </nav>

        <div className="header-actions">
          <label className="search-box">
            <Search size={17} />
            <input
              placeholder="Search stories..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
            />
          </label>
          <button className="icon-button" aria-label="Notifications">
            <Bell size={19} />
          </button>
          <button className="profile-button">
            <UserRound size={18} />
            <span>Sign in</span>
          </button>
          <button
            className="mobile-menu-button"
            onClick={() => setMenuOpen(!menuOpen)}
            aria-label="Toggle menu"
          >
            {menuOpen ? <X /> : <Menu />}
          </button>
        </div>
      </header>

      {menuOpen && (
        <nav className="mobile-nav">
          <a href="#explore" onClick={() => setMenuOpen(false)}>Explore</a>
          <a href="#featured" onClick={() => setMenuOpen(false)}>Featured</a>
          <a href="#latest" onClick={() => setMenuOpen(false)}>Latest</a>
          <a href="#recommended" onClick={() => setMenuOpen(false)}>For You</a>
        </nav>
      )}

      <main>
        <section className="hero">
          <div className="hero-content">
            <span className="hero-eyebrow">
              <Sparkles size={14} /> YOUR NEXT FAVORITE STORY
            </span>
            <h1>Stories beyond<br />imagination.</h1>
            <p>
              Discover beautiful stories, unforgettable characters
              and worlds waiting to be explored.
            </p>
            <a href="#explore" className="hero-button">
              Explore stories <ChevronRight size={17} />
            </a>
          </div>
          <div className="hero-decoration">
            <span>✦</span>
            <span>✧</span>
            <span>✦</span>
          </div>
        </section>

        <section className="explore-section" id="explore">
          <div className="section-heading">
            <div>
              <div className="section-title">
                <Compass size={20} />
                <h2>Explore</h2>
              </div>
              <p>Find your next reading adventure.</p>
            </div>
          </div>

          <div className="category-list">
            {categories.map((item) => (
              <button
                key={item}
                className={category === item ? "category active-category" : "category"}
                onClick={() => setCategory(item)}
              >
                {item}
              </button>
            ))}
          </div>

          {filteredStories.length > 0 ? (
            <div className="story-grid">
              {filteredStories.map((story) => (
                <StoryCard key={story.id} story={story} />
              ))}
            </div>
          ) : (
            <p className="empty-message">No stories found.</p>
          )}
        </section>

        <div id="featured">
          <StorySection
            title="Featured Stories"
            subtitle="Stories worth discovering."
            icon={<Sparkles size={20} />}
            items={stories.slice(0, 4)}
          />
        </div>

        <div id="latest">
          <StorySection
            title="Latest Updates"
            subtitle="Fresh chapters, just for you."
            icon={<Clock3 size={20} />}
            items={stories.slice(2, 6)}
          />
        </div>

        <div id="recommended">
          <StorySection
            title="Recommended for You"
            subtitle="A little something based on your taste."
            icon={<Heart size={20} />}
            items={stories.slice(0, 4).reverse()}
          />
        </div>
      </main>

      <footer className="footer">
        <a className="brand footer-brand" href="#">
          <span className="brand-mark">M</span>
          <span>MEROVA</span>
        </a>
        <p>Every story has a world of its own.</p>
        <span>© 2026 MEROVA. All rights reserved.</span>
      </footer>
    </div>
  );
}
